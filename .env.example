# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas claves al repositorio.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_, así no
# llegan nunca al navegador.

# Libro de reclamaciones (Supabase > Project Settings > API).
# La clave es la secreta (sb_secret_...) o la service_role antigua.
# También van en Vercel > Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Portal de clientes (prototipo). Existe solo si estas tres variables
# están definidas; para apagarlo, bórralas.
# El hash se genera con: node scripts/hash-password.mjs "contraseña"
# El secreto: cualquier texto aleatorio de 32 caracteres o más.
PORTAL_DEMO_EMAIL=
PORTAL_DEMO_PASSWORD_HASH=
PORTAL_SESSION_SECRET=
