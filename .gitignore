# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# snapshots de desarrollo (utilidad /api/snap)
/.snaps/

# reclamos y sesiones de prueba guardados en local (solo desarrollo)
/.data/

# videos de lanzamiento generados con /brag (pesados, no son parte del sitio)
/brag-output*/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# la plantilla solo tiene nombres de variables, sin valores
!.env.example

# vercel
.vercel

# configuración local de Claude Code (skills, launch.json) — herramienta,
# no parte del sitio
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
